{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/blog-sitemap.xml",
      "destination": "https://app.wodstory.com/blog/sitemap.xml"
    },
    {
      "source": "/feed.xml",
      "destination": "https://app.wodstory.com/blog/rss.xml"
    },
    {
      "source": "/blog",
      "destination": "https://app.wodstory.com/blog"
    },
    {
      "source": "/blog/:path*",
      "destination": "https://app.wodstory.com/blog/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://app.wodstory.com/_next/:path*"
    },
    {
      "source": "/fonts/:path*",
      "destination": "https://app.wodstory.com/fonts/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://tools.dezigniacs.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; font-src 'self' data: https://cdnjs.cloudflare.com; img-src 'self' data: https:; connect-src 'self' https://app.wodstory.com https://tools.dezigniacs.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
