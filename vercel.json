{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/blog-sitemap.xml",
      "destination": "https://app.wodstory.com/blog/sitemap.xml"
    },
    {
      "source": "/feed.xml",
      "destination": "https://app.wodstory.com/blog/rss.xml"
    },
    {
      "source": "/blog",
      "destination": "https://app.wodstory.com/blog"
    },
    {
      "source": "/blog/:path*",
      "destination": "https://app.wodstory.com/blog/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://app.wodstory.com/_next/:path*"
    },
    {
      "source": "/fonts/:path*",
      "destination": "https://app.wodstory.com/fonts/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-mkHT2nSuMdclOHqy3ZoQKP30W1Rb9R29UVgZfa8XX0M=' 'sha256-CG75nI86TyugH0LPyod/SQ8BYaKDhqBlxD5V988quFw=' 'sha256-FJMDVnmdWYN6gc8vhPdmTeHS2EU8qfcomH7p1zUAekw=' https://tools.dezigniacs.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; font-src 'self' data: https://cdnjs.cloudflare.com; img-src 'self' data: https:; connect-src 'self' https://app.wodstory.com https://tools.dezigniacs.com; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
